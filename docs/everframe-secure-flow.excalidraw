{
  "type": "excalidraw",
  "version": 2,
  "source": "hermes-agent",
  "elements": [
    { "type": "text", "id": "title", "x": 480, "y": 20, "width": 520, "height": 28, "text": "EverFrame — Secure Device Auth & Image Fetch", "fontSize": 26, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "EverFrame — Secure Device Auth & Image Fetch", "autoResize": true },
    { "type": "text", "id": "subtitle", "x": 420, "y": 52, "width": 640, "height": 16, "text": "Device holds a secret · every fetch is authenticated · images via short-lived signed URLs", "fontSize": 14, "fontFamily": 1, "strokeColor": "#868e96", "originalText": "Device holds a secret · every fetch is authenticated · images via short-lived signed URLs", "autoResize": true },

    { "type": "rectangle", "id": "z1", "x": 30, "y": 88, "width": 1380, "height": 200, "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeColor": "#74c0fc", "strokeWidth": 1.5, "roundness": { "type": 3 }, "roughness": 0 },
    { "type": "text", "id": "z1-lbl", "x": 42, "y": 98, "width": 300, "height": 14, "text": "PHASE 1  ·  FIRST BOOT (device generates its own credential)", "fontSize": 12, "fontFamily": 1, "strokeColor": "#1864ab", "originalText": "PHASE 1  ·  FIRST BOOT (device generates its own credential)", "autoResize": true },

    { "type": "rectangle", "id": "z2", "x": 30, "y": 308, "width": 1380, "height": 220, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#fcc419", "strokeWidth": 1.5, "roundness": { "type": 3 }, "roughness": 0 },
    { "type": "text", "id": "z2-lbl", "x": 42, "y": 318, "width": 420, "height": 14, "text": "PHASE 2  ·  REGISTER & PENDING POLL (every poll is already authenticated)", "fontSize": 12, "fontFamily": 1, "strokeColor": "#e67700", "originalText": "PHASE 2  ·  REGISTER & PENDING POLL (every poll is already authenticated)", "autoResize": true },

    { "type": "rectangle", "id": "z3", "x": 30, "y": 548, "width": 1380, "height": 260, "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeColor": "#69db7c", "strokeWidth": 1.5, "roundness": { "type": 3 }, "roughness": 0 },
    { "type": "text", "id": "z3-lbl", "x": 42, "y": 558, "width": 360, "height": 14, "text": "PHASE 3  ·  WEBSITE CLAIM (Google authed user links the frame)", "fontSize": 12, "fontFamily": 1, "strokeColor": "#2b5930", "originalText": "PHASE 3  ·  WEBSITE CLAIM (Google authed user links the frame)", "autoResize": true },

    { "type": "rectangle", "id": "z4", "x": 30, "y": 828, "width": 1380, "height": 300, "backgroundColor": "#f3f0ff", "fillStyle": "solid", "strokeColor": "#9775fa", "strokeWidth": 1.5, "roundness": { "type": 3 }, "roughness": 0 },
    { "type": "text", "id": "z4-lbl", "x": 42, "y": 838, "width": 420, "height": 14, "text": "PHASE 4  ·  AUTHENTICATED FETCH (every wake, forever)", "fontSize": 12, "fontFamily": 1, "strokeColor": "#5f3dc4", "originalText": "PHASE 4  ·  AUTHENTICATED FETCH (every wake, forever)", "autoResize": true },

    { "type": "rectangle", "id": "n-gen", "x": 70, "y": 128, "width": 280, "height": 70, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-gen", "type": "text" }] },
    { "type": "text", "id": "t-gen", "x": 80, "y": 141, "width": 260, "height": 44, "text": "Generate on device\ndeviceId 128-bit + secret 256-bit", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-gen", "originalText": "Generate on device\ndeviceId 128-bit + secret 256-bit", "autoResize": true },
    { "type": "text", "id": "f-gen", "x": 110, "y": 204, "width": 200, "height": 14, "text": "device_identity.c → NVS", "fontSize": 11, "fontFamily": 1, "strokeColor": "#868e96", "originalText": "device_identity.c → NVS", "autoResize": true },

    { "type": "rectangle", "id": "n-hash", "x": 430, "y": 128, "width": 260, "height": 70, "backgroundColor": "#d0bfff", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-hash", "type": "text" }] },
    { "type": "text", "id": "t-hash", "x": 440, "y": 141, "width": 240, "height": 44, "text": "SHA256(secret) = tokenHash\n+ activationCode = A7F3K9", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-hash", "originalText": "SHA256(secret) = tokenHash\n+ activationCode = A7F3K9", "autoResize": true },

    { "type": "rectangle", "id": "n-store", "x": 770, "y": 128, "width": 260, "height": 70, "backgroundColor": "#c3fae8", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-store", "type": "text" }] },
    { "type": "text", "id": "t-store", "x": 780, "y": 141, "width": 240, "height": 44, "text": "Store secret in NVS\n(never leaves device)", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-store", "originalText": "Store secret in NVS\n(never leaves device)", "autoResize": true },

    { "type": "rectangle", "id": "n-qr1", "x": 1110, "y": 128, "width": 240, "height": 70, "backgroundColor": "#fff3bf", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-qr1", "type": "text" }] },
    { "type": "text", "id": "t-qr1", "x": 1120, "y": 141, "width": 220, "height": 44, "text": "Derive 6-char code\nA7F3K9 from deviceId", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-qr1", "originalText": "Derive 6-char code\nA7F3K9 from deviceId", "autoResize": true },

    { "type": "arrow", "id": "a1", "x": 350, "y": 163, "width": 80, "height": 0, "points": [[0,0],[80,0]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow", "startBinding": { "elementId": "n-gen", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-hash", "fixedPoint": [0, 0.5] } },
    { "type": "arrow", "id": "a2", "x": 690, "y": 163, "width": 80, "height": 0, "points": [[0,0],[80,0]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow", "startBinding": { "elementId": "n-hash", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-store", "fixedPoint": [0, 0.5] } },
    { "type": "arrow", "id": "a3", "x": 1030, "y": 163, "width": 80, "height": 0, "points": [[0,0],[80,0]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "strokeStyle": "dashed", "endArrowhead": "arrow", "startBinding": { "elementId": "n-store", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-qr1", "fixedPoint": [0, 0.5] } },

    { "type": "rectangle", "id": "n-reg", "x": 70, "y": 348, "width": 300, "height": 70, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-reg", "type": "text" }] },
    { "type": "text", "id": "t-reg", "x": 80, "y": 361, "width": 280, "height": 44, "text": "POST /registerDevice\n{ deviceId, tokenHash, code: A7F3K9 }", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-reg", "originalText": "POST /registerDevice\n{ deviceId, tokenHash, code: A7F3K9 }", "autoResize": true },
    { "type": "text", "id": "f-reg", "x": 90, "y": 424, "width": 260, "height": 14, "text": "Cloud Function → Firestore pending", "fontSize": 11, "fontFamily": 1, "strokeColor": "#868e96", "originalText": "Cloud Function → Firestore pending", "autoResize": true },

    { "type": "rectangle", "id": "n-pending", "x": 430, "y": 348, "width": 260, "height": 70, "backgroundColor": "#fff3bf", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-pending", "type": "text" }] },
    { "type": "text", "id": "t-pending", "x": 440, "y": 361, "width": 240, "height": 44, "text": "Firestore: devices/{id}\n{ code: A7F3K9, status: pending }", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-pending", "originalText": "Firestore: devices/{id}\n{ code: A7F3K9, status: pending }", "autoResize": true },

    { "type": "rectangle", "id": "n-poll1", "x": 770, "y": 348, "width": 280, "height": 70, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-poll1", "type": "text" }] },
    { "type": "text", "id": "t-poll1", "x": 780, "y": 356, "width": 260, "height": 54, "text": "Poll every 30s (pending)\nGET /devicePoll + Bearer <secret>\n→ { claimed: false }", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-poll1", "originalText": "Poll every 30s (pending)\nGET /devicePoll + Bearer <secret>\n→ { claimed: false }", "autoResize": true },

    { "type": "rectangle", "id": "n-sleep", "x": 1110, "y": 348, "width": 240, "height": 70, "backgroundColor": "#e9ecef", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#868e96", "strokeWidth": 1.5, "boundElements": [{ "id": "t-sleep", "type": "text" }] },
    { "type": "text", "id": "t-sleep", "x": 1120, "y": 361, "width": 220, "height": 44, "text": "Display QR + AP\n+ sleep 1h if not claimed", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-sleep", "originalText": "Display QR + AP\n+ sleep 1h if not claimed", "autoResize": true },

    { "type": "arrow", "id": "b1", "x": 370, "y": 383, "width": 60, "height": 0, "points": [[0,0],[60,0]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow", "startBinding": { "elementId": "n-reg", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-pending", "fixedPoint": [0, 0.5] } },
    { "type": "arrow", "id": "b2", "x": 690, "y": 383, "width": 80, "height": 0, "points": [[0,0],[80,0]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow", "startBinding": { "elementId": "n-pending", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-poll1", "fixedPoint": [0, 0.5] } },
    { "type": "arrow", "id": "b3", "x": 1050, "y": 383, "width": 60, "height": 0, "points": [[0,0],[60,0]], "strokeColor": "#868e96", "strokeWidth": 2, "strokeStyle": "dashed", "endArrowhead": "arrow", "startBinding": { "elementId": "n-poll1", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-sleep", "fixedPoint": [0, 0.5] } },

    { "type": "rectangle", "id": "n-scan", "x": 70, "y": 590, "width": 260, "height": 70, "backgroundColor": "#d0bfff", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-scan", "type": "text" }] },
    { "type": "text", "id": "t-scan", "x": 80, "y": 603, "width": 240, "height": 44, "text": "Scan QR on frame\n→ /activate?code=A7F3K9", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-scan", "originalText": "Scan QR on frame\n→ /activate?code=A7F3K9", "autoResize": true },

    { "type": "rectangle", "id": "n-auth", "x": 400, "y": 590, "width": 240, "height": 70, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-auth", "type": "text" }] },
    { "type": "text", "id": "t-auth", "x": 410, "y": 603, "width": 220, "height": 44, "text": "Google Sign-In\nAuthGate checks user", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-auth", "originalText": "Google Sign-In\nAuthGate checks user", "autoResize": true },

    { "type": "rectangle", "id": "n-query", "x": 710, "y": 590, "width": 280, "height": 70, "backgroundColor": "#fff3bf", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-query", "type": "text" }] },
    { "type": "text", "id": "t-query", "x": 720, "y": 603, "width": 260, "height": 44, "text": "query devices\nwhere code == A7F3K9\nwhere status == pending", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-query", "originalText": "query devices\nwhere code == A7F3K9\nwhere status == pending", "autoResize": true },

    { "type": "rectangle", "id": "n-claim", "x": 1060, "y": 590, "width": 280, "height": 70, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-claim", "type": "text" }] },
    { "type": "text", "id": "t-claim", "x": 1070, "y": 603, "width": 260, "height": 44, "text": "updateDoc( device )\n{ userId: uid, status: claimed }", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-claim", "originalText": "updateDoc( device )\n{ userId: uid, status: claimed }", "autoResize": true },
    { "type": "text", "id": "f-claim", "x": 1080, "y": 666, "width": 240, "height": 14, "text": "firestore.rules: isActivationClaim()", "fontSize": 11, "fontFamily": 1, "strokeColor": "#868e96", "originalText": "firestore.rules: isActivationClaim()", "autoResize": true },

    { "type": "arrow", "id": "c1", "x": 330, "y": 625, "width": 70, "height": 0, "points": [[0,0],[70,0]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow", "startBinding": { "elementId": "n-scan", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-auth", "fixedPoint": [0, 0.5] } },
    { "type": "arrow", "id": "c2", "x": 640, "y": 625, "width": 70, "height": 0, "points": [[0,0],[70,0]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow", "startBinding": { "elementId": "n-auth", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-query", "fixedPoint": [0, 0.5] } },
    { "type": "arrow", "id": "c3", "x": 990, "y": 625, "width": 70, "height": 0, "points": [[0,0],[70,0]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow", "startBinding": { "elementId": "n-query", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-claim", "fixedPoint": [0, 0.5] } },

    { "type": "rectangle", "id": "n-poll-note", "x": 70, "y": 700, "width": 640, "height": 50, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#e67700", "strokeWidth": 1.2, "roundness": { "type": 3 }, "strokeStyle": "dashed", "boundElements": [{ "id": "t-poll-note", "type": "text" }] },
    { "type": "text", "id": "t-poll-note", "x": 80, "y": 710, "width": 620, "height": 30, "text": "Device is NOT pushed — it discovers claim on its NEXT authenticated poll (30s / next wake)", "fontSize": 13, "fontFamily": 1, "strokeColor": "#704800", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-poll-note", "originalText": "Device is NOT pushed — it discovers claim on its NEXT authenticated poll (30s / next wake)", "autoResize": true },

    { "type": "arrow", "id": "c4", "x": 1200, "y": 660, "width": 0, "height": 40, "points": [[0,0],[0,40]], "strokeColor": "#868e96", "strokeWidth": 1.5, "strokeStyle": "dashed", "endArrowhead": "arrow", "startBinding": { "elementId": "n-claim", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "n-poll-note", "fixedPoint": [1, 0.5] } },

    { "type": "rectangle", "id": "n-poll2", "x": 70, "y": 880, "width": 300, "height": 70, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-poll2", "type": "text" }] },
    { "type": "text", "id": "t-poll2", "x": 80, "y": 893, "width": 280, "height": 44, "text": "GET /devicePoll\nAuthorization: Bearer <secret>", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-poll2", "originalText": "GET /devicePoll\nAuthorization: Bearer <secret>", "autoResize": true },
    { "type": "text", "id": "f-poll2", "x": 96, "y": 956, "width": 250, "height": 14, "text": "esp_http_client + mbedTLS (TLS 1.2)", "fontSize": 11, "fontFamily": 1, "strokeColor": "#868e96", "originalText": "esp_http_client + mbedTLS (TLS 1.2)", "autoResize": true },

    { "type": "diamond", "id": "n-verify", "x": 430, "y": 870, "width": 260, "height": 90, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-verify", "type": "text" }] },
    { "type": "text", "id": "t-verify", "x": 440, "y": 895, "width": 240, "height": 40, "text": "Verify: SHA256(secret)\n== device.tokenHash\n& status == claimed ?", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-verify", "originalText": "Verify: SHA256(secret)\n== device.tokenHash\n& status == claimed ?", "autoResize": true },

    { "type": "rectangle", "id": "n-reject", "x": 430, "y": 980, "width": 260, "height": 50, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-reject", "type": "text" }] },
    { "type": "text", "id": "t-reject", "x": 440, "y": 993, "width": 240, "height": 24, "text": "401 Unauthorized", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-reject", "originalText": "401 Unauthorized", "autoResize": true },

    { "type": "rectangle", "id": "n-lookup", "x": 770, "y": 880, "width": 280, "height": 70, "backgroundColor": "#e7f5ff", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-lookup", "type": "text" }] },
    { "type": "text", "id": "t-lookup", "x": 780, "y": 893, "width": 260, "height": 44, "text": "Lookup: devices/{id} → userId\n→ users/{uid}/manifest.json", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-lookup", "originalText": "Lookup: devices/{id} → userId\n→ users/{uid}/manifest.json", "autoResize": true },

    { "type": "rectangle", "id": "n-sign", "x": 1110, "y": 880, "width": 260, "height": 70, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-sign", "type": "text" }] },
    { "type": "text", "id": "t-sign", "x": 1120, "y": 893, "width": 240, "height": 44, "text": "Sign URL (server-side)\n15-min expiry, service account", "fontSize": 13, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "n-sign", "originalText": "Sign URL (server-side)\n15-min expiry, service account", "autoResize": true },

    { "type": "arrow", "id": "d1", "x": 370, "y": 915, "width": 60, "height": 0, "points": [[0,0],[60,0]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow", "startBinding": { "elementId": "n-poll2", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-verify", "fixedPoint": [0, 0.5] } },
    { "type": "arrow", "id": "d2", "x": 560, "y": 960, "width": 0, "height": 20, "points": [[0,0],[0,20]], "strokeColor": "#c92a2a", "strokeWidth": 2, "endArrowhead": "arrow", "startBinding": { "elementId": "n-verify", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "n-reject", "fixedPoint": [0.5, 0] } },
    { "type": "text", "id": "t-d2", "x": 570, "y": 964, "width": 40, "height": 12, "text": "no", "fontSize": 11, "fontFamily": 1, "strokeColor": "#c92a2a", "originalText": "no", "autoResize": true },
    { "type": "arrow", "id": "d3", "x": 690, "y": 915, "width": 80, "height": 0, "points": [[0,0],[80,0]], "strokeColor": "#2b8a3e", "strokeWidth": 2, "endArrowhead": "arrow", "startBinding": { "elementId": "n-verify", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-lookup", "fixedPoint": [0, 0.5] } },
    { "type": "text", "id": "t-d3", "x": 700, "y": 898, "width": 40, "height": 12, "text": "yes", "fontSize": 11, "fontFamily": 1, "strokeColor": "#2b8a3e", "originalText": "yes", "autoResize": true },
    { "type": "arrow", "id": "d4", "x": 1050, "y": 915, "width": 60, "height": 0, "points": [[0,0],[60,0]], "strokeColor": "#2b8a3e", "strokeWidth": 2, "endArrowhead": "arrow", "startBinding": { "elementId": "n-lookup", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "n-sign", "fixedPoint": [0, 0.5] } },

    { "type": "rectangle", "id": "n-return", "x": 770, "y": 980, "width": 280, "height": 60, "backgroundColor": "#c3fae8", "fillStyle": "solid", "roundness": { "type": 3 }, "strokeColor": "#1e1e1e", "boundElements": [{ "id": "t-return", "type": "text" }] },
