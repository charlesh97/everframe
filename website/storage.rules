rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Per-user image storage: users/{uid}/images/... and users/{uid}/daily/...
    // The dashboard now writes under users/{uid}/images/ and the Cloud Function
    // writes daily bins under users/{uid}/daily/. Any signed-in user may read/write
    // their own prefix; broad bucket access is retained during migration.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Retain broad access for the flat images/ prefix during migration
    match /images/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Fallback for any other legacy paths
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
