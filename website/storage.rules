rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // The browser owns only source artwork. Processor artifacts and manifests
    // are Admin-SDK-only so a client cannot make a device fetch arbitrary data.
    match /users/{userId}/images/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/daily/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /users/{userId}/manifest.json {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    // Everything outside a user's own prefix is private. The Admin SDK used by
    // Cloud Functions bypasses these client rules.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
