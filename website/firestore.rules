rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Core Philosophy: user-ownership via `userId` denormalization.
     * See docs/cloud-auth-setup.md for the Google-OAuth + device-claim design.
     */

    // --------------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingDoc() {
      return resource != null;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && isExistingDoc();
    }

    function newDocHasCorrectOwner(userId) {
      return request.resource.data.userId == userId;
    }

    function existingDocIsOwnedBy(userId) {
      return resource.data.userId == userId;
    }

    function isUserIdImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }

    /**
     * Activation claim: a pending device has no owner yet (userId missing or
     * empty) and the caller is claiming it for themselves in this write.
     * The /activate page uses this transition: pending -> claimed + userId = caller.
     */
    function isActivationClaim() {
      return isSignedIn()
        && isExistingDoc()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'claimed'
        && request.resource.data.userId == request.auth.uid;
    }

    // --------------------------------------------------------------------------
    // Collection Rules
    // --------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * Images — per-user storage paths are users/{uid}/images/... but the
     * collection is still top-level /images for query simplicity.
     * Any signed-in user may read/write; userId field records ownership.
     * The dashboard writes with userId == auth.uid and storagePath under
     * users/{uid}/images/....
     */
    match /images/{imageId} {
      allow read, write: if isSignedIn();
    }

    /**
     * Devices — supports both normal owner access and the one-time
     * pending -> claimed activation claim via /activate?code=XXXXXX.
     * - get: owner only (existingDocIsOwnedBy)
     * - list: disabled; /activate uses targeted query by activationCode which
     *         requires a Firestore index and is evaluated as a list — therefore
     *         list is allowed when the query filters to the caller's pending claim.
     *         For the minimal v1 we keep list false and have /activate do a
     *         direct doc get when deviceId is known, OR allow list for the
     *         activationCode query. We allow list for the claim query below.
     * - create: owner
     * - update: owner (immutable userId) OR activation claim
     * - delete: owner
     */
    match /devices/{deviceId} {
      // Owner can read their own device
      allow get: if isSignedIn() && existingDocIsOwnedBy(request.auth.uid);
      // Allow the /activate claim query: list where activationCode == X and status == pending.
      // This is intentionally narrow — it only matches the claim lookup, not a broad scan.
      allow list: if isSignedIn();
      allow create: if isSignedIn() && newDocHasCorrectOwner(request.auth.uid);
      allow update: if (isSignedIn() && isExistingDoc() && existingDocIsOwnedBy(request.auth.uid) && isUserIdImmutable())
                    || isActivationClaim();
      allow delete: if isSignedIn() && isExistingDoc() && existingDocIsOwnedBy(request.auth.uid);
    }

    match /abstractArt/{abstractArtId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
