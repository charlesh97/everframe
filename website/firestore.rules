rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Core Philosophy: user-ownership via `userId` denormalization.
     * See docs/cloud-auth-setup.md for the Google-OAuth + device-claim design.
     */

    // --------------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingDoc() {
      return resource != null;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && isExistingDoc();
    }

    function existingDocIsOwnedBy(userId) {
      return resource.data.userId == userId;
    }

    // --------------------------------------------------------------------------
    // Collection Rules
    // --------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);

      /**
       * Owner-managed visual-style clauses used by the optional image
       * generation stage. A style is deliberately a small structured record,
       * rather than one mutable array on the user document, so edits do not
       * overwrite another tab's additions and each record can be validated.
       */
      match /generationStyles/{styleId} {
        function isValidStyle() {
          return request.resource.data.keys().hasOnly([
              'userId', 'label', 'prompt', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.userId == userId
            && request.resource.data.label is string
            && request.resource.data.label.size() > 0
            && request.resource.data.label.size() <= 60
            && request.resource.data.prompt is string
            && request.resource.data.prompt.size() > 0
            && request.resource.data.prompt.size() <= 160
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp;
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidStyle();
        allow update: if isOwner(userId)
          && isValidStyle()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'label', 'prompt', 'updatedAt'
          ]);
        allow delete: if isOwner(userId);
      }
    }

    /**
     * Images — per-user storage paths are users/{uid}/images/... but the
     * collection is still top-level /images for query simplicity.
     * Clients may read and mutate only their own records.
     * The dashboard writes with userId == auth.uid and storagePath under
     * users/{uid}/images/....
     */
    match /images/{imageId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.storagePath.matches('users/' + request.auth.uid + '/images/.*');
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.storagePath == resource.data.storagePath;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /**
     * Devices — clients can directly get/delete only an already-owned device.
     * Registration, activation lookup, and claim writes use server-side Admin SDK.
     * - get: owner only (existingDocIsOwnedBy)
     * - list/create/update: disabled for clients
     * - delete: owner
     */
    match /devices/{deviceId} {
      // Owner can read their own device
      allow get: if isSignedIn() && existingDocIsOwnedBy(request.auth.uid);
      // Activation lookup and mutation happen in claimDevice using Admin SDK.
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if isSignedIn() && isExistingDoc() && existingDocIsOwnedBy(request.auth.uid);
    }

    match /abstractArt/{abstractArtId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
